# Copy to infra/compose/.env on the server and fill in. Never commit the real file.
DOMAIN=example.com
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=animarka
RABBITMQ_PASSWORD=change-me
# Signs the links the render worker opens. Any long random string, same for web and worker.
RENDER_SECRET=change-me-to-a-long-random-string
# Optional: raises the GitHub rate limit for the catalog ingest.
GITHUB_TOKEN=
# Queue dashboard at https://$DOMAIN/flower, behind basic auth.
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-to-a-long-random-string
# Backups (scripts/backup.sh). An rclone remote named "bucket", here as S3 compatible storage
# (AWS S3, Backblaze B2, Cloudflare R2 and others). Use a bucket on another provider than the server.
BACKUP_REMOTE=bucket:animarka-backups
BACKUP_KEEP_DAYS=14
RCLONE_CONFIG_BUCKET_TYPE=s3
RCLONE_CONFIG_BUCKET_PROVIDER=Other
RCLONE_CONFIG_BUCKET_ENDPOINT=https://s3.example.com
RCLONE_CONFIG_BUCKET_ACCESS_KEY_ID=change-me
RCLONE_CONFIG_BUCKET_SECRET_ACCESS_KEY=change-me
