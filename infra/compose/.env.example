# Copy to infra/compose/.env on the server and fill in. Never commit the real file.
DOMAIN=example.com
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=animarka
RABBITMQ_PASSWORD=change-me
# Signs the links the render worker opens. Any long random string, same for web and worker.
RENDER_SECRET=change-me-to-a-long-random-string
# Optional: raises the GitHub rate limit for the catalog ingest.
GITHUB_TOKEN=
